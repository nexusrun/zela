[Unit]
Description=Zela Docker Cluster Control Plane
After=network-online.target
Wants=network-online.target

[Service]
User=zela
Group=zela
EnvironmentFile=/etc/zela/zela-server.env
ExecStart=/usr/local/bin/zela-server --listen 0.0.0.0:8080 --data /var/lib/zela --worker-binaries /opt/zela/workers --tls-cert /etc/zela/control.crt --tls-key /etc/zela/control.key
StateDirectory=zela
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
