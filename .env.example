# Copy to .env and replace this value with a private random password.
# Generate a password with: openssl rand -hex 32
ZELA_POSTGRES_PASSWORD=replace-with-a-random-password

# Enable OAuth for ChatGPT/Claude; use the external HTTPS origin, without /mcp.
# ZELA_MCP_PUBLIC_URL=https://cluster.example.com
# Optional exact callback allowlist; replaces the built-in ChatGPT/Claude callbacks.
# ZELA_MCP_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect,https://claude.ai/api/mcp/auth_callback
# Hosts (IPs, CIDRs or exact hostnames) that mcp_manage credentials may provision.
# Empty means only administrators can provision workers.
# ZELA_MCP_PROVISION_HOSTS=10.0.10.0/24,build-01.example.internal
# Reverse-proxy IPs/CIDRs whose X-Forwarded-For identifies OAuth clients for rate limiting.
# ZELA_MCP_TRUSTED_PROXIES=10.0.0.10
