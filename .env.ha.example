# Copy to .env.ha; protect with chmod 600 and populate before starting Compose.
# Generate ZELA_POSTGRES_PASSWORD and ZELA_ADMIN_TOKEN with: openssl rand -hex 32
# For a NEW cluster, generate ZELA_VAULT_KEY with: openssl rand -base64 32
# For an EXISTING cluster, reuse its original admin token and vault master key.
ZELA_POSTGRES_PASSWORD=
ZELA_ADMIN_TOKEN=
ZELA_VAULT_KEY=

# Enable OAuth for ChatGPT/Claude; use the external HTTPS origin, without /mcp.
# ZELA_MCP_PUBLIC_URL=https://cluster.example.com
# Optional exact callback allowlist; replaces the built-in ChatGPT/Claude callbacks.
# ZELA_MCP_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect,https://claude.ai/api/mcp/auth_callback
# Hosts (IPs, CIDRs or exact hostnames) that mcp_manage credentials may provision; empty = administrators only.
# ZELA_MCP_PROVISION_HOSTS=10.0.10.0/24
# Proxy IPs/CIDRs whose X-Forwarded-For identifies OAuth clients (enable "option forwardfor" in HAProxy first).
# ZELA_MCP_TRUSTED_PROXIES=172.16.0.0/12
